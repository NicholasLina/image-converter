<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:CompileBindings="False"
        d:DesignWidth="1200"
        d:DesignHeight="760"
        x:Class="ImageConverter.Gui.MainWindow"
        Width="1200"
        Height="760"
        MinWidth="800"
        MinHeight="520"
        Title="Image Converter"
        Background="#0A0A11">

    <!-- Root panel — entire window is the drag-and-drop target -->
    <Grid Name="RootPanel"
          DragDrop.AllowDrop="True"
          DragDrop.DragOver="RootPanel_OnDragOver"
          DragDrop.Drop="RootPanel_OnDrop">

        <DockPanel>

            <!-- ── Header bar ── -->
            <Border DockPanel.Dock="Top"
                    Background="#111119"
                    BorderBrush="#1C1C2A"
                    BorderThickness="0,0,0,1"
                    Padding="22,0">
                <Grid Height="54" ColumnDefinitions="Auto,*,Auto">

                    <TextBlock Grid.Column="0"
                               Text="Image Converter"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Foreground="#D4D4E8" />

                    <TextBlock Grid.Column="1"
                               Text="Drop images or folders anywhere to add them"
                               FontSize="12"
                               Foreground="#2E2E46"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Center" />

                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                Spacing="6"
                                VerticalAlignment="Center">
                        <Button Name="AddFilesButton"
                                Content="Add Files"
                                Click="AddFilesButton_OnClick"
                                Padding="14,7" />
                        <Button Name="AddFolderButton"
                                Content="Add Folder"
                                Click="AddFolderButton_OnClick"
                                Padding="14,7" />
                        <Button Name="RemoveSelectedButton"
                                Content="Remove"
                                Click="RemoveSelectedButton_OnClick"
                                Padding="14,7" />
                        <Button Name="ClearButton"
                                Content="Clear"
                                Click="ClearButton_OnClick"
                                Padding="14,7" />
                        <Button Name="EstimateButton"
                                Content="Refresh Estimates"
                                Click="EstimateButton_OnClick"
                                Padding="14,7" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ── Status bar ── -->
            <Border DockPanel.Dock="Bottom"
                    Background="#111119"
                    BorderBrush="#1C1C2A"
                    BorderThickness="0,1,0,0"
                    Height="42"
                    Padding="22,0">
                <Grid ColumnDefinitions="*,260" ColumnSpacing="16">
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Spacing="18"
                                VerticalAlignment="Center">
                        <TextBlock Name="SummaryText"
                                   Text="Queue is empty."
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <TextBlock Name="EstimateSummaryText"
                                   Text="Estimated output: --"
                                   FontSize="12"
                                   Foreground="#3A3A58"
                                   VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Grid.Column="1"
                                 Name="ConversionProgressBar"
                                 Height="4"
                                 CornerRadius="2"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="0"
                                 VerticalAlignment="Center" />
                </Grid>
            </Border>

            <!-- ── Main content: file queue + resizable sidebar ── -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="360" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="300" MinWidth="220" />
                </Grid.ColumnDefinitions>

                <!-- File queue -->
                <DataGrid Grid.Column="0"
                          Name="JobsGrid"
                          Margin="14,12,8,12"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Extended"
                          GridLinesVisibility="Horizontal"
                          CanUserSortColumns="False"
                          CanUserReorderColumns="False"
                          CanUserResizeColumns="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="File"           Binding="{Binding FileName}"      Width="2*"  />
                        <DataGridTextColumn Header="Input Path"     Binding="{Binding InputPath}"     Width="4*"  />
                        <DataGridTextColumn Header="Source Size"    Binding="{Binding SourceSize}"    Width="110" />
                        <DataGridTextColumn Header="Estimated Size" Binding="{Binding EstimatedSize}" Width="120" />
                        <DataGridTextColumn Header="Status"         Binding="{Binding Status}"        Width="*"   />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Drag handle between queue and sidebar -->
                <GridSplitter Grid.Column="1"
                              Background="#1C1C2A"
                              ResizeDirection="Columns"
                              HorizontalAlignment="Stretch"
                              Cursor="SizeWestEast" />

                <!-- Settings sidebar -->
                <Border Grid.Column="2"
                        Background="#0E0E18"
                        BorderBrush="#1C1C2A"
                        BorderThickness="1,0,0,0">
                    <ScrollViewer Padding="22,20,22,20"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <!-- Output format -->
                            <TextBlock Text="OUTPUT FORMAT"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#36365A"
                                       LetterSpacing="1"
                                       Margin="0,0,0,8" />
                            <ComboBox Name="FormatComboBox"
                                      HorizontalAlignment="Stretch"
                                      Margin="0,0,0,24"
                                      SelectionChanged="FormatComboBox_OnSelectionChanged">
                                <ComboBoxItem Content="JPEG (.jpg)"  Tag="Jpeg" />
                                <ComboBoxItem Content="PNG (.png)"   Tag="Png"  />
                                <ComboBoxItem Content="WebP (.webp)" Tag="WebP" />
                                <ComboBoxItem Content="AVIF (.avif)" Tag="Avif" />
                                <ComboBoxItem Content="TIFF (.tiff)" Tag="Tiff" />
                                <ComboBoxItem Content="BMP (.bmp)"   Tag="Bmp"  />
                                <ComboBoxItem Content="GIF (.gif)"   Tag="Gif"  />
                            </ComboBox>

                            <!-- Quality -->
                            <TextBlock Text="QUALITY"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#36365A"
                                       LetterSpacing="1"
                                       Margin="0,0,0,8" />
                            <Grid ColumnDefinitions="*,44" ColumnSpacing="10" Margin="0,0,0,4">
                                <Slider Grid.Column="0"
                                        Name="QualitySlider"
                                        Minimum="1"
                                        Maximum="100"
                                        TickFrequency="1"
                                        ValueChanged="QualitySlider_OnValueChanged"
                                        IsSnapToTickEnabled="True"
                                        VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1"
                                           Name="QualityLabel"
                                           Text="85"
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold" />
                            </Grid>
                            <TextBlock Name="QualityHelpText"
                                       Text="(used for JPEG/AVIF)"
                                       FontSize="11"
                                       Foreground="#36365A"
                                       Margin="0,0,0,24" />

                            <!-- Output folder -->
                            <TextBlock Text="OUTPUT FOLDER"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="#36365A"
                                       LetterSpacing="1"
                                       Margin="0,0,0,8" />
                            <TextBox Name="OutputFolderTextBox"
                                     IsReadOnly="True"
                                     Watermark="Choose destination folder"
                                     TextWrapping="WrapWithOverflow"
                                     AcceptsReturn="True"
                                     MinHeight="60"
                                     Margin="0,0,0,8" />
                            <Button Name="BrowseOutputButton"
                                    Content="Browse…"
                                    Click="BrowseOutputButton_OnClick"
                                    HorizontalAlignment="Stretch"
                                    Padding="0,8"
                                    Margin="0,0,0,0" />

                            <!-- Divider -->
                            <Border Height="1"
                                    Background="#1C1C2A"
                                    Margin="0,28,0,28" />

                            <!-- Convert action -->
                            <Button Name="ConvertButton"
                                    Content="Convert All"
                                    Click="ConvertButton_OnClick"
                                    HorizontalAlignment="Stretch"
                                    Height="44"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Classes="accent" />

                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>

        </DockPanel>
    </Grid>
</Window>
